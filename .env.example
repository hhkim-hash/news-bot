# 로컬 실습용. 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 git에 올라가지 않습니다)
#   cp .env.example .env
# GitHub Actions에서는 이 파일 대신 레포 Settings → Secrets and variables → Actions 에 등록합니다.

NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 비워두면 Slack 대신 터미널에 결과를 출력합니다 (실습 시작용)
SLACK_WEBHOOK_URL=
SLACK_WEBHOOK_URL_2=

# 선택: AI 판단 단계. 비워두면 건너뜁니다
TYPESAFE_API_KEY=
